# ============================================================
# Multimodal Document Intelligence — Environment Configuration
# Copy this file to .env and fill in the values.
# ============================================================

# --------------- Ollama Configuration ---------------
# URL of your local Ollama server
OLLAMA_BASE_URL=http://localhost:11434

# Primary LLM model (text generation + optional vision)
# Recommended: qwen2.5:3b  |  alternatives: llama3.2:3b, phi3:mini
OLLAMA_MODEL=qwen2.5:3b

# Vision-Language Model (must support images)
# Recommended: llava:7b  |  alternatives: moondream, bakllava
# Leave blank to disable image understanding
OLLAMA_VISION_MODEL=llava:7b

# Request timeout for Ollama calls (seconds)
OLLAMA_TIMEOUT=120

# --------------- Embedding Model ---------------
# HuggingFace Sentence Transformers model name
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Embedding batch size (reduce if RAM is limited)
EMBEDDING_BATCH_SIZE=32

# --------------- ChromaDB ---------------
CHROMA_PERSIST_DIR=./database/chroma_db
CHROMA_COLLECTION_NAME=document_chunks

# --------------- Document Processing ---------------
# Max file size in MB
MAX_FILE_SIZE_MB=100

# Max pages to process per document (0 = unlimited)
MAX_PAGES_PER_DOC=0

# Max images to send to VLM per document
MAX_IMAGES_PER_DOC=20

# Enable OCR (true/false)
ENABLE_OCR=true

# --------------- RAG Configuration ---------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Number of top chunks to retrieve
TOP_K=5

# --------------- Storage Paths ---------------
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
EXTRACTED_IMAGES_DIR=./data/extracted_images
OUTPUTS_DIR=./data/outputs
CACHE_DIR=./data/cache
METADATA_DB=./database/metadata/documents.db

# --------------- Application ---------------
# Set to "development" or "production"
APP_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
