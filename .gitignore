!data/uploads/.gitkeep
!data/processed/.gitkeep
!data/extracted_images/.gitkeep
!data/outputs/.gitkeep
!data/cache/.gitkeep
!database/chroma_db/.gitkeep
!database/metadata/.gitkeep

